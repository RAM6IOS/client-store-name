# BITA COD Starter API - environment template
# Copy to apps/api/.env and adjust. NEVER commit real secrets.

NODE_ENV=development
PORT=3001

# Include an explicit user: Prisma migrate requires it on Homebrew Postgres.
DATABASE_URL=postgresql://macbookpro@localhost:5432/bita_cod_starter

CORS_ORIGINS=http://localhost:3000

# Shared key for administrative catalog/inventory mutations (Phase 2).
# Sent by clients as the `x-admin-api-key` header. Replaced by JWT + RBAC in
# Phase 3 (ADR-0007); generate a strong random value per deployment.
ADMIN_API_KEY=change-me-to-a-long-random-value
