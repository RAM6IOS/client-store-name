{
  "name": "@bita/api",
  "version": "0.1.0",
  "private": true,
  "description": "BITA COD Starter API (NestJS 12 + Prisma 7)",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "predev": "prisma generate",
    "dev": "nest start --watch",
    "prestart": "prisma generate",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "pretest": "prisma generate",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:e2e": "prisma generate && jest --config ./test/jest-e2e.json --runInBand",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^18.0.7",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  }
}
