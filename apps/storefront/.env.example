# BITA COD Starter storefront - environment template
# Copy to apps/storefront/.env.local

# --- API connection ---------------------------------------------------------
# Public base URL of the NestJS API (include the /api global prefix).
# Read in the browser and on the server.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Optional server-only override used by SSR data fetching. When unset the
# server falls back to NEXT_PUBLIC_API_URL. Useful to reach the API over an
# internal host while the browser uses a public one.
# API_BASE_URL=http://localhost:3001/api

# --- Store branding (deploy-time, no secrets) -------------------------------
# Every value has a neutral default; set these per client deployment.
# NEXT_PUBLIC_STORE_NAME=متجر
# NEXT_PUBLIC_STORE_TAGLINE=
# NEXT_PUBLIC_STORE_LOGO_URL=
# NEXT_PUBLIC_STORE_FONT=

# Absolute site URL used for canonical URLs and social metadata.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brand colors (CSS custom properties applied on <html>).
# NEXT_PUBLIC_BRAND_PRIMARY=#0f766e
# NEXT_PUBLIC_BRAND_PRIMARY_CONTRAST=#ffffff
# NEXT_PUBLIC_BRAND_ACCENT=#f59e0b
# NEXT_PUBLIC_BRAND_BACKGROUND=#ffffff
# NEXT_PUBLIC_BRAND_SURFACE=#f8fafc
# NEXT_PUBLIC_BRAND_TEXT=#111827
# NEXT_PUBLIC_BRAND_MUTED=#6b7280
# NEXT_PUBLIC_BRAND_BORDER=#e5e7eb
# NEXT_PUBLIC_BRAND_DANGER=#b91c1c

# Support details shown in the footer (optional).
# NEXT_PUBLIC_SUPPORT_PHONE=
# NEXT_PUBLIC_SUPPORT_EMAIL=
# NEXT_PUBLIC_SUPPORT_ADDRESS=

# Homepage hero copy override (optional).
# NEXT_PUBLIC_HERO_TITLE=
# NEXT_PUBLIC_HERO_SUBTITLE=

# Featured products on the homepage. Products are curated in the admin with the
# "عرض في المنتجات المميزة" flag; this only controls how many are shown (1..24).
# NEXT_PUBLIC_FEATURED_LIMIT=8

# Optional category artwork shown on the homepage category cards, keyed by
# category slug. JSON object; categories without an entry fall back to a built-in
# icon. Remote hosts must be allowed in next.config.ts (images.remotePatterns).
# NEXT_PUBLIC_CATEGORY_IMAGES={"electronics":"/images/categories/electronics.jpg","fashion":"/images/categories/fashion.jpg"}

# --- Localization -----------------------------------------------------------
# The locale cookie ("ar" | "fr") is set at runtime; there is no build-time
# locale configuration. See docs/decisions/0013-storefront-i18n.md.
