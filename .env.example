# BITA COD Starter - environment template
#
# Copy this file to the location each app expects:
#   cp .env.example apps/api/.env
#   cp .env.example apps/storefront/.env.local
#
# NEVER commit real .env files or secrets. See docs/architecture.md for details.

# ----------------------------------------------------------------------------
# API (NestJS) - apps/api/.env
# ----------------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# Port the NestJS API listens on
PORT=3001

# PostgreSQL connection string.
# IMPORTANT: include an explicit user (Prisma migrate requires it), e.g.
#   postgresql://USER@localhost:5432/bita_cod_starter
DATABASE_URL=postgresql://macbookpro@localhost:5432/bita_cod_starter

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Shared key required by administrative catalog/inventory mutations (Phase 2).
# Sent as the `x-admin-api-key` header. Replaced by JWT + RBAC in Phase 3.
ADMIN_API_KEY=change-me-to-a-long-random-value

# ----------------------------------------------------------------------------
# Storefront (Next.js) - apps/storefront/.env.local
# ----------------------------------------------------------------------------

# Public base URL of the NestJS API (include the /api global prefix).
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Optional server-only API base for SSR (falls back to NEXT_PUBLIC_API_URL).
# API_BASE_URL=http://localhost:3001/api

# Per-deployment store branding (all optional; neutral defaults apply).
# Never the agency brand. See apps/storefront/.env.example for the full list.
# NEXT_PUBLIC_STORE_NAME=
# NEXT_PUBLIC_STORE_TAGLINE=
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_BRAND_PRIMARY=#0f766e
# NEXT_PUBLIC_FEATURED_HANDLES=
# NEXT_PUBLIC_FEATURED_LIMIT=8
